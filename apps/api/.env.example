# RentUZ API environment — full catalog lives in context/0_Phase.md §5.
# Values below are local-development defaults; never commit real secrets.

NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://postgres:postgres@localhost:5434/rentuz?schema=public&search_path=public,extensions
DATABASE_DIRECT_URL=postgresql://postgres:postgres@localhost:5434/rentuz?search_path=public,extensions

REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=phase0-dev-secret-change-me
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL=30d
SOCKET_TICKET_SECRET=phase0-dev-socket-secret

COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000

STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_BUCKET_PUBLIC=rentuz-public
STORAGE_BUCKET_PRIVATE=rentuz-private
PUBLIC_STORAGE_BASE_URL=http://localhost:9000/rentuz-public

SMS_PROVIDER=console
AUTH_OTP_DEV_MODE=true

# Test conveniences (never set in production):
# DISABLE_THROTTLE=true   — skip Redis rate limiting (integration/E2E suites)
# DISABLE_JOBS=true       — don't schedule BullMQ jobs (BullMQ fires overdue
#                           cron slots on boot, which races test fixtures)
AUTO_APPROVE_LISTINGS=true

FX_RATES_URL=https://cbu.uz/oz/arkhiv-kursov-valyut/json/
LOG_LEVEL=debug
SENTRY_DSN=

ADMIN_PHONE=+998901234567
ADMIN_INITIAL_PASSWORD=
# Phase 6 notifications retention sweep (daily 03:00 Asia/Tashkent)
NOTIFICATIONS_READ_RETENTION_DAYS=90
NOTIFICATIONS_UNREAD_RETENTION_DAYS=30
