# RentUZ Web environment — full catalog lives in context/0_Phase.md §5.

# BFF proxy target (server-side only; the browser never calls the API directly)
INTERNAL_API_URL=http://localhost:4000

# Direct WS origin (Vercel cannot proxy WebSockets — client connects straight)
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Map tiles: dev = OSM raster demo; prod = MapTiler style URL (pre-launch item)
NEXT_PUBLIC_MAP_TILES_URL=

NEXT_PUBLIC_SENTRY_DSN=
